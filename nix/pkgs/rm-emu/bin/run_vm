#!/bin/sh

set -eu

backing_path="${BACKING_IMAGE:-/opt/root/rootfs.qcow2}"
root_path="${ROOT_IMAGE:-/tmp/$(echo $BACKING_IMAGE | md5sum | cut -f1 -d' ').qcow2}"
kernel_path=${KERNEL_PATH:-/opt/zImage}
dtb_path=${DTB_PATH:-/opt/imx7d-rm.dtb}
ssh_port=${SSH_PORT:-22}

if ! [ -f "$root_path" ] && [ -f "$backing_path" ]; then
  mkdir -p $(dirname $root_path)
  if qemu-img snapshot -l $backing_path | grep -q main; then
    echo "Snapshot in backing image, copying"
    cp "$backing_path" "$root_path"
    chmod +w "$root_path"
  else
    echo "No image found, creating new one at $root_path"
    qemu-img create -b "$backing_path" -F qcow2 -f qcow2 "$root_path"
  fi

  # || true so extr4 fs don't fail.
  chattr +C "$root_path" || true
fi

load_state=""
if qemu-img snapshot -l $root_path | grep -q main; then
  echo "Snapshot found, loading"
  load_state="-loadvm main"
fi

virtfs_args=""
if [ -n "${VIRTFS_STORE_PATH:-}" ]; then
  # security_model=none, not mapped-xattr: the latter hits an ELOOP bug
  # resolving symlinks (e.g. libfoo.so -> libfoo.so.N) on this old (5.4)
  # ARM guest kernel's 9p client. None is fine here since we're sharing a
  # real, already-root-owned, read-only host store - no uid/gid mapping
  # needed.
  virtfs_args="-fsdev local,security_model=none,id=fsstore,path=$VIRTFS_STORE_PATH,readonly=on -device virtio-9p-pci,fsdev=fsstore,mount_tag=${VIRTFS_MOUNT_TAG:-nix-store}"
fi

echo "Staring QEMU..."
qemu-system-arm \
  -machine mcimx7d-sabre \
  -cpu cortex-a9 \
  -smp 2 \
  -m 2048 \
  -kernel $kernel_path \
  -dtb $dtb_path \
  -drive if=sd,file=$root_path,format=qcow2,index=2 \
  -append "@commandline@" \
  -nic user,hostfwd=tcp::$ssh_port-:22,hostfwd=tcp::8888-:8888 \
  -monitor tcp::5555,server=on,wait=off \
  -parallel null -display none \
  $load_state \
  $virtfs_args \
  "$@"
